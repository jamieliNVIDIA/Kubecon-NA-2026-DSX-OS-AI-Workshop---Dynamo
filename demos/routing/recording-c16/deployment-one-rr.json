{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "resource.k8s.io/v1",
      "kind": "ResourceClaimTemplate",
      "metadata": {
        "name": "ft-agg-agg-main-gpus",
        "namespace": "dynamo-ft-routing-overnight-20261105-a1",
        "labels": {
          "app.kubernetes.io/managed-by": "kubecon-dynamo-feature-tests",
          "feature-test-run": "dynamo-ft-routing-overnight-20261105-a1"
        }
      },
      "spec": {
        "spec": {
          "devices": {
            "requests": [
              {
                "name": "gpu",
                "exactly": {
                  "deviceClassName": "gpu.nvidia.com",
                  "count": 2,
                  "selectors": [
                    {
                      "cel": {
                        "expression": "device.driver == \"gpu.nvidia.com\" && has(device.attributes[\"gpu.nvidia.com\"].uuid) && device.attributes[\"gpu.nvidia.com\"].uuid in [\"GPU-3aea3e1e-63c3-41cd-43be-4e379ed995b5\", \"GPU-08dc0ef4-2e92-4cc2-6adc-b735980a1326\", \"GPU-c15ae016-71f1-03bc-0228-624adbb1b4e8\", \"GPU-4aacb1e1-a109-70bb-6b72-8071d736ba75\"]"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "nvidia.com/v1beta1",
      "kind": "DynamoGraphDeployment",
      "metadata": {
        "name": "ft-agg",
        "namespace": "dynamo-ft-routing-overnight-20261105-a1",
        "labels": {
          "app.kubernetes.io/managed-by": "kubecon-dynamo-feature-tests",
          "feature-test-run": "dynamo-ft-routing-overnight-20261105-a1"
        }
      },
      "spec": {
        "backendFramework": "vllm",
        "components": [
          {
            "name": "Frontend",
            "type": "frontend",
            "replicas": 1,
            "podTemplate": {
              "spec": {
                "containers": [
                  {
                    "name": "main",
                    "image": "nvcr.io/nvidian/dynamo-dev/nealv@sha256:e98d074e84e584a93967aa2f53e2c1092cea631034b1b9277c8753f8c3ba307d",
                    "imagePullPolicy": "IfNotPresent",
                    "command": [
                      "python3",
                      "-m",
                      "dynamo.frontend"
                    ],
                    "args": [
                      "--router-mode",
                      "round-robin",
                      "--kv-cache-block-size",
                      "64",
                      "--trust-remote-code"
                    ],
                    "env": [
                      {
                        "name": "HF_HOME",
                        "value": "/model-cache/feature-tests/20261015-super-vl-tp2/hf"
                      },
                      {
                        "name": "HF_HUB_OFFLINE",
                        "value": "1"
                      },
                      {
                        "name": "HF_MODULES_CACHE",
                        "value": "/tmp/hf_modules"
                      },
                      {
                        "name": "PYTHONHASHSEED",
                        "value": "0"
                      },
                      {
                        "name": "NCCL_IB_DISABLE",
                        "value": "1"
                      },
                      {
                        "name": "NVIDIA_VISIBLE_DEVICES",
                        "value": "void"
                      }
                    ],
                    "resources": {
                      "requests": {
                        "cpu": "1",
                        "memory": "4Gi"
                      },
                      "limits": {
                        "memory": "8Gi"
                      }
                    },
                    "startupProbe": {
                      "httpGet": {
                        "path": "/health",
                        "port": 8000
                      },
                      "periodSeconds": 10,
                      "timeoutSeconds": 60,
                      "failureThreshold": 60
                    },
                    "volumeMounts": [
                      {
                        "name": "shared-model-cache",
                        "mountPath": "/model-cache"
                      },
                      {
                        "name": "dshm",
                        "mountPath": "/dev/shm"
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "shared-model-cache",
                    "persistentVolumeClaim": {
                      "claimName": "feature-cache"
                    }
                  },
                  {
                    "name": "dshm",
                    "emptyDir": {
                      "medium": "Memory",
                      "sizeLimit": "16Gi"
                    }
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "common-runtime-pull"
                  }
                ],
                "activeDeadlineSeconds": 21600,
                "nodeSelector": {
                  "kubernetes.io/hostname": "kubecon-nke-site-cp-0942"
                }
              },
              "metadata": {
                "labels": {
                  "app.kubernetes.io/managed-by": "kubecon-dynamo-feature-tests",
                  "feature-test-run": "dynamo-ft-routing-overnight-20261105-a1"
                }
              }
            },
            "runtimeVersionOverride": "1.6.0"
          },
          {
            "name": "agg",
            "type": "worker",
            "replicas": 1,
            "sharedMemorySize": "16Gi",
            "podTemplate": {
              "spec": {
                "affinity": {
                  "nodeAffinity": {
                    "requiredDuringSchedulingIgnoredDuringExecution": {
                      "nodeSelectorTerms": [
                        {
                          "matchExpressions": [
                            {
                              "key": "nvidia.com/gpu.product",
                              "operator": "In",
                              "values": [
                                "NVIDIA-H100-80GB-HBM3"
                              ]
                            },
                            {
                              "key": "kubernetes.io/hostname",
                              "operator": "In",
                              "values": [
                                "kubecon-nke-site-cp-0198"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "podAntiAffinity": {
                    "requiredDuringSchedulingIgnoredDuringExecution": [
                      {
                        "labelSelector": {
                          "matchLabels": {
                            "feature-test-role": "agg"
                          }
                        },
                        "topologyKey": "kubernetes.io/hostname"
                      }
                    ]
                  }
                },
                "tolerations": [
                  {
                    "key": "nvidia.com/gpu",
                    "operator": "Equal",
                    "value": "true",
                    "effect": "NoSchedule"
                  }
                ],
                "volumes": [
                  {
                    "name": "shared-model-cache",
                    "persistentVolumeClaim": {
                      "claimName": "feature-cache"
                    }
                  },
                  {
                    "name": "dshm",
                    "emptyDir": {
                      "medium": "Memory",
                      "sizeLimit": "16Gi"
                    }
                  }
                ],
                "containers": [
                  {
                    "name": "main",
                    "image": "nvcr.io/nvidian/dynamo-dev/nealv@sha256:e98d074e84e584a93967aa2f53e2c1092cea631034b1b9277c8753f8c3ba307d",
                    "imagePullPolicy": "IfNotPresent",
                    "workingDir": "/workspace/",
                    "command": [
                      "python3",
                      "-m",
                      "dynamo.vllm"
                    ],
                    "args": [
                      "--model",
                      "nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4",
                      "--revision",
                      "8a115b9d966adce8c059a7bcf47f49a1e57957d8",
                      "--served-model-name",
                      "nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4",
                      "--trust-remote-code",
                      "--tensor-parallel-size",
                      "2",
                      "--max-num-seqs",
                      "128",
                      "--max-num-batched-tokens",
                      "8192",
                      "--gpu-memory-utilization",
                      "0.85",
                      "--enable-prefix-caching",
                      "--block-size",
                      "64",
                      "--mamba-backend",
                      "flashinfer",
                      "--mamba-ssm-cache-dtype",
                      "float16",
                      "--mamba-cache-mode",
                      "align",
                      "--reasoning-parser",
                      "nemotron_v3",
                      "--kv-events-config",
                      "{\"publisher\":\"zmq\",\"topic\":\"kv-events\",\"endpoint\":\"tcp://*:20080\",\"enable_kv_cache_events\":true}",
                      "--disaggregation-mode",
                      "agg",
                      "--limit-mm-per-prompt",
                      "{\"image\":1,\"video\":0}",
                      "--language-model-only"
                    ],
                    "env": [
                      {
                        "name": "HF_HOME",
                        "value": "/model-cache/feature-tests/20261015-super-vl-tp2/hf"
                      },
                      {
                        "name": "HF_HUB_OFFLINE",
                        "value": "1"
                      },
                      {
                        "name": "HF_MODULES_CACHE",
                        "value": "/tmp/hf_modules"
                      },
                      {
                        "name": "PYTHONHASHSEED",
                        "value": "0"
                      },
                      {
                        "name": "NCCL_IB_DISABLE",
                        "value": "1"
                      },
                      {
                        "name": "DYN_HEALTH_CHECK_REQUEST_TIMEOUT",
                        "value": "180"
                      },
                      {
                        "name": "DYN_CANARY_WAIT_TIME",
                        "value": "1"
                      },
                      {
                        "name": "VLLM_CACHE_ROOT",
                        "value": "/tmp/workshop-vllm-cache"
                      },
                      {
                        "name": "TRITON_CACHE_DIR",
                        "value": "/tmp/workshop-triton-cache"
                      },
                      {
                        "name": "DG_JIT_CACHE_DIR",
                        "value": "/tmp/workshop-deepgemm-cache"
                      },
                      {
                        "name": "FLASHINFER_WORKSPACE_BASE",
                        "value": "/tmp/workshop-flashinfer-cache"
                      }
                    ],
                    "resources": {
                      "requests": {
                        "cpu": "8",
                        "memory": "128Gi"
                      },
                      "limits": {
                        "memory": "256Gi"
                      },
                      "claims": [
                        {
                          "name": "gpu-main"
                        }
                      ]
                    },
                    "securityContext": {
                      "runAsUser": 0,
                      "capabilities": {
                        "add": [
                          "IPC_LOCK",
                          "SYS_RESOURCE"
                        ]
                      }
                    },
                    "startupProbe": {
                      "httpGet": {
                        "path": "/live",
                        "port": 9090
                      },
                      "periodSeconds": 2,
                      "timeoutSeconds": 20,
                      "failureThreshold": 1800
                    },
                    "volumeMounts": [
                      {
                        "name": "shared-model-cache",
                        "mountPath": "/model-cache"
                      },
                      {
                        "name": "dshm",
                        "mountPath": "/dev/shm"
                      }
                    ],
                    "readinessProbe": {
                      "failureThreshold": 3,
                      "httpGet": {
                        "path": "/health",
                        "port": "system",
                        "scheme": "HTTP"
                      },
                      "periodSeconds": 2,
                      "successThreshold": 1,
                      "timeoutSeconds": 4
                    }
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "common-runtime-pull"
                  }
                ],
                "activeDeadlineSeconds": 21600,
                "resourceClaims": [
                  {
                    "name": "gpu-main",
                    "resourceClaimTemplateName": "ft-agg-agg-main-gpus"
                  }
                ]
              },
              "metadata": {
                "labels": {
                  "app.kubernetes.io/managed-by": "kubecon-dynamo-feature-tests",
                  "feature-test-run": "dynamo-ft-routing-overnight-20261105-a1",
                  "feature-test-role": "agg"
                }
              }
            },
            "runtimeVersionOverride": "1.6.0"
          }
        ]
      }
    }
  ]
}
